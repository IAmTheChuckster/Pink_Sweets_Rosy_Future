<!--
  ikacore_CV1k MRA - Pink Sweets Rosy Forever (2026/10/29 ROSY Forever).

  Rom order is deliberate - DDR3 first, index 0 LAST.  Index 0's download
  is what finally releases the CPU, so every image is in place before the
  core runs, and any spurious run in an inter-rom gap is wiped by the u4
  download's own reset hold.

    <rom index="1">  DDR3 0x34400000  u2  NAND dump incl. spare (132 MiB,
                                          exact size)
    <rom index="2">  DDR3 0x3C800000  u23 YMZ chip 0, zero-padded to the
                                          8 MiB slot
                     DDR3 0x3D000000  u24 YMZ chip 1, zero-padded to the
                                          8 MiB slot
    <rom index="0">  ioctl stream     u4  program NOR x2 (2 MiB file listed
                                          twice = the undecoded-A21 mirror
                                          the boot ROM expects)
-->
<misterromdescription>
    <about author="ika-musume" source="https://github.com/ika-musume/ikacore_CV1k"/>
    <name>Pink Sweets Rosy Forever (2026/10/29 ROSY Forever)</name>
    <setname>pinkswtsfe</setname>
    <year>2026</year>
    <manufacturer>Cave (AMI license)</manufacturer>
    <category>Shooter</category>
    <rbf>ikacore_CV1k</rbf>

    <rom index="1" address="0x34400000" zip="pinkswtsfe.zip" md5="none">
        <part name="pinkswts_u2" crc="a2fa5363"/>
    </rom>

    <rom index="2" address="0x3C800000" zip="pinkswtsfe.zip" md5="none">
        <part name="u23" crc="4b82d250"/>
        <part repeat="0x400000">00</part>
        <part name="u24" crc="e93f0627"/>
        <part repeat="0x400000">00</part>
    </rom>

    <nvram index="3" size="135680"/>

    <rom index="0" zip="pinkswtsfe.zip" md5="none">
        <part name="pinkswtsfe_u4" crc="01a0d6ae"/>
        <part name="pinkswtsfe_u4" crc="01a0d6ae"/>
    </rom>

    <buttons names="Focus Shot,Option/Rose Cracker,Rapid Shot,Type Change,Start,Coin,Test,Service,Save State" default="A,B,X,Y,Start,R,L,Select"/>
</misterromdescription>
